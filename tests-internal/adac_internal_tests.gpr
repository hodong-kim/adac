project Adac_Internal_Tests is

  Target_Name := external
    ("ADAC_TARGET", external ("TARGET", "x86_64-unknown-freebsd"));

  Build_Profile_Name := external
    ("ADAC_BUILD_PROFILE",
     external ("PROFILE", external ("BUILD", "release")));

  type Build_Profile_Type is ("debug", "release");
  Build_Profile : Build_Profile_Type := external
    ("ADAC_BUILD_PROFILE",
     external ("PROFILE", external ("BUILD", "release")));

  for Source_Dirs use
    (".",
     "../src",
     "../src/adac/ast",
     "../src/adac/compilation",
     "../src/adac/diagnostics",
     "../src/adac/frontend",
     "../src/adac/ir",
     "../src/adac/sema",
     "../src/adac/source",
     "../src/adac/symbols",
     "../src/adac/support");

  for Object_Dir use
    "../build/obj/" & Target_Name & "/" &
    Build_Profile_Name & "/internal-tests";
  for Exec_Dir use
    "../build/bin/" & Target_Name & "/" & Build_Profile_Name;

  for Main use ("adac_internal_tests.adb");

  package Builder is
    for Executable ("adac_internal_tests.adb") use "adac-internal-tests";
  end Builder;

  Ada_Common_Switches :=
    ("-gnat2022",
     "-Wall",
     "-Wextra",
     "-Werror",
     "-gnata");

  package Compiler is
    case Build_Profile is
      when "debug" =>
        for Default_Switches ("Ada") use
          Ada_Common_Switches & ("-O0", "-g");

      when "release" =>
        for Default_Switches ("Ada") use
          Ada_Common_Switches & ("-O2");
    end case;
  end Compiler;

end Adac_Internal_Tests;

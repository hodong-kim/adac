project Adac_Internal_Tests extends "../adac_common.gpr" is

  for Source_Dirs use
    (".",
     "../tests-support",
     "../src",
     "../src/adac/ast",
     "../src/adac/compilation",
     "../src/adac/diagnostics",
     "../src/adac/frontend",
     "../src/adac/ir",
     "../src/adac/sema",
     "../src/adac/semantics",
     "../src/adac/source",
     "../src/adac/symbols",
     "../src/adac/support");

  for Object_Dir use
    "../build/obj/" & Target_Name & "/" &
    Build_Profile_Name & "/internal-tests";
  for Exec_Dir use
    "../build/bin/" & Target_Name & "/" & Build_Profile_Name;

  for Main use ("adac_internal_tests.adb");

  package Builder is
    for Executable ("adac_internal_tests.adb") use "adac-internal-tests";
  end Builder;


end Adac_Internal_Tests;

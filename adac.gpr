project Adac extends "adac_common.gpr" is

  Generated_Source_Dir :=
    external ("ADAC_GENERATED_SOURCE_DIR",
              "build/generated/" & Target_Name & "/" & Build_Profile_Name);

  for Source_Dirs use
    (Generated_Source_Dir,
     "src",
     "src/adac/compilation",
     "src/adac/frontend",
     "src/adac/driver",
     "src/adac/ast",
     "src/adac/sema",
     "src/adac/semantics",
     "src/adac/ir",
     "src/adac/backend",
     "src/adac/diagnostics",
     "src/adac/source",
     "src/adac/symbols",
     "src/adac/support");

  for Object_Dir use "build/obj/" & Target_Name & "/" & Build_Profile_Name;
  for Exec_Dir   use "build/bin/" & Target_Name & "/" & Build_Profile_Name;

  for Main use ("adac_main.adb");

  package Builder is
    for Executable ("adac_main.adb") use "adac";
  end Builder;

end Adac;

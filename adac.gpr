project adac is

  for Source_Dirs use
    ("src",
     "src/adac/frontend",
     "src/adac/driver",
     "src/adac/ast",
     "src/adac/sema",
     "src/adac/ir",
     "src/adac/backend",
     "src/adac/diagnostics",
     "src/adac/source",
     "src/adac/support");

  for Object_Dir use "obj";
  for Exec_Dir   use "bin";

  for Main use ("adac_main.adb");

  package Builder is
    for Executable ("adac_main.adb") use "adac";
  end Builder;

  package Compiler is
    for Default_Switches ("Ada") use
      ("-gnat2022",
       "-Wall",
       "-Wextra",
       "-Werror",
       -- Enable pragma assert and related runtime assertion checks.
       "-gnata");
  end Compiler;

end adac;
